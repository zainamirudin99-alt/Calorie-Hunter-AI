# ==============================================================================
# CALORIE HUNTER AI — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# Supabase (Public - Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Admin (Server-only - DO NOT EXPOSE TO CLIENT)
# Used for synthetic email auth without confirmation
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API (Server-only - DO NOT EXPOSE TO CLIENT)
# Get from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Vercel Cron Security Secret (Server-only)
CRON_SECRET=your-random-cron-secret-token-here
